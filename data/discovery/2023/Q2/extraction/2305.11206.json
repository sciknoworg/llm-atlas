  "paper_metadata": {
    "arxiv_id": "2305.11206",
    "title": "LIMA: Less Is More for Alignment",
    "authors": [
      "Chunting Zhou",
      "Pengfei Liu",
      "Puxin Xu",
      "Srini Iyer",
      "Jiao Sun",
      "Yuning Mao",
      "Xuezhe Ma",
      "Avia Efrat",
