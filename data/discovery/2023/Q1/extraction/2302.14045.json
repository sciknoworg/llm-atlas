 "paper_metadata": {
  "arxiv_id": "2302.14045",
  "title": "Language Is Not All You Need: Aligning Perception with Language Models",
  "authors": [
   "Shaohan Huang",
   "Li Dong",
   "Wenhui Wang",
   "Yaru Hao",
   "Saksham Singhal",
   "Shuming Ma",
   "Tengchao Lv",
   "Lei Cui",
   "Owais Khan Mohammed",
   "Barun Patra",
   "Qiang Liu",
   "Kriti Aggarwal",
