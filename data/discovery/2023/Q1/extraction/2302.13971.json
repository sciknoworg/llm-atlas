  "arxiv_id": "2302.13971",
  "title": "LLaMA: Open and Efficient Foundation Language Models",
  "authors": [
   "Hugo Touvron",
   "Thibaut Lavril",
   "Gautier Izacard",
   "Xavier Martinet",
   "Marie-Anne Lachaux",
