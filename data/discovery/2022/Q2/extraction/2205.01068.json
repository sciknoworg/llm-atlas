 "paper_metadata": {
  "arxiv_id": "2205.01068",
  "title": "OPT: Open Pre-trained Transformer Language Models",
  "authors": [
   "Susan Zhang",
   "Stephen Roller",
   "Naman Goyal",
   "Mikel Artetxe",
   "Moya Chen",
   "Shuohui Chen",
   "Christopher Dewan",
