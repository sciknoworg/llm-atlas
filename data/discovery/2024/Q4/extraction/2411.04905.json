  "paper_metadata": {
    "arxiv_id": "2411.04905",
    "title": "OpenCoder: The Open Cookbook for Top-Tier Code Large Language Models",
    "authors": [
      "Siming Huang",
      "Tianhao Cheng",
      "J. K. Liu",
      "Jiaran Hao",
      "Liuyihan Song",
