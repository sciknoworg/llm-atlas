  "paper_metadata": {
    "arxiv_id": "2412.03555",
    "title": "PaliGemma 2: A Family of Versatile VLMs for Transfer",
    "authors": [
      "Andreas Steiner",
      "André Susano Pinto",
      "Michael Tschannen",
      "Daniel Keysers",
      "Xiao Wang",
      "Yonatan Bitton",
