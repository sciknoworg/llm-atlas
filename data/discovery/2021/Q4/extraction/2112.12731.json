  "paper_metadata": {
    "arxiv_id": "2112.12731",
    "title": "ERNIE 3.0 Titan: Exploring Larger-scale Knowledge Enhanced Pre-training for Language Understanding and Generation",
    "authors": [
      "Shuohuan Wang",
      "Yu Sun",
      "Yang Xiang",
